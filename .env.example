# ==================================================
# AHARQR APP FRONTEND ENVIRONMENT CONFIGURATION EXAMPLE
# ==================================================
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env

# Node environment. Vite sets this automatically ('development' when running
# `vite`, 'production' when running `vite build`), so you usually do NOT need
# to set it here. It is only listed for reference. Prefer `import.meta.env.DEV`
# / `import.meta.env.PROD` in code instead of reading this value.
NODE_ENV=development

# Fastify Backend API Base URL
VITE_API_URL=http://localhost:3000/api

# Google OAuth Client ID (for "Continue with Google" login/signup)
# ------------------------------------------------------------------
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an "OAuth client ID" of type "Web application".
# 3. Add authorized JavaScript origins:
#      http://localhost:5173   (Vite dev server)
#      https://<your-domain>   (production)
#    and authorized redirect URIs as needed for the backend.
# 4. Paste the resulting client ID here, e.g.:
#      1234567890-abc123.apps.googleusercontent.com
# This Client ID is used client-side by @react-oauth/google. The backend
# independently validates the OAuth code/credential via its own
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (see server/.env.example), so
# both the web client ID and server OAuth app must be configured together.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
